//@version=6
indicator("Daily Trade Study - Oct 14 2026", overlay=true, max_labels_count=60)
// Study only: discretionary price levels sourced premarket Oct 14, 2026.
// Eight fixed price levels remain visible; signals/alerts only during Oct 14 regular-hours morning.
showLabels = input.bool(true, "Show compact labels")
showPD = input.bool(true, "Show PDH/PDL references")
requireVolume = input.bool(false, "Require 1.3x 20-bar average volume")
morningOnly = input.bool(true, "Signals 09:40-12:00 NY only")
string tz = "America/New_York"
float le = na
float ls = na
float lt1 = na
float lt2 = na
float se = na
float ss = na
float st1 = na
float st2 = na
string symbol = "NOT ON TODAY'S LIST"
if syminfo.ticker == "BAC"
    le := 51.25
    ls := 50.40
    lt1 := 52.40
    lt2 := 53.65
    se := 49.70
    ss := 50.55
    st1 := 48.60
    st2 := 47.45
    symbol := "BAC"
if syminfo.ticker == "STT"
    le := 162.25
    ls := 159.70
    lt1 := 165.35
    lt2 := 168.55
    se := 157.50
    ss := 160.00
    st1 := 154.20
    st2 := 150.80
    symbol := "STT"
if syminfo.ticker == "PGR"
    le := 212.80
    ls := 209.90
    lt1 := 216.50
    lt2 := 220.40
    se := 207.80
    ss := 210.60
    st1 := 204.20
    st2 := 200.10
    symbol := "PGR"
if syminfo.ticker == "HPE"
    le := 66.85
    ls := 65.65
    lt1 := 68.40
    lt2 := 70.00
    se := 64.90
    ss := 66.15
    st1 := 63.30
    st2 := 61.80
    symbol := "HPE"
if syminfo.ticker == "DELL"
    le := 561.50
    ls := 551.50
    lt1 := 574.00
    lt2 := 586.00
    se := 544.50
    ss := 553.50
    st1 := 533.00
    st2 := 521.00
    symbol := "DELL"
if syminfo.ticker == "MS"
    le := 185.20
    ls := 182.90
    lt1 := 188.10
    lt2 := 191.20
    se := 180.70
    ss := 183.10
    st1 := 177.55
    st2 := 174.30
    symbol := "MS"
if syminfo.ticker == "BLK"
    le := 1107.00
    ls := 1092.00
    lt1 := 1126.00
    lt2 := 1146.00
    se := 1085.00
    ss := 1100.00
    st1 := 1066.00
    st2 := 1047.00
    symbol := "BLK"
if syminfo.ticker == "MU"
    le := 943.00
    ls := 934.00
    lt1 := 954.00
    lt2 := 966.50
    se := 926.50
    ss := 935.00
    st1 := 915.00
    st2 := 901.00
    symbol := "MU"
if syminfo.ticker == "NVDA"
    le := 229.20
    ls := 226.95
    lt1 := 232.00
    lt2 := 235.10
    se := 223.80
    ss := 226.00
    st1 := 220.90
    st2 := 217.70
    symbol := "NVDA"
if syminfo.ticker == "XOM"
    le := 175.60
    ls := 174.35
    lt1 := 177.25
    lt2 := 179.00
    se := 172.95
    ss := 174.35
    st1 := 171.10
    st2 := 169.20
    symbol := "XOM"

// Discretionary levels: green entry long; red entry short. Stops and targets distinct.
plot(le, "LONG ABOVE", color=color.lime, linewidth=2, style=plot.style_linebr)
plot(ls, "LONG STOP", color=color.orange, linewidth=1, style=plot.style_linebr)
plot(lt1, "LONG TARGET 1", color=color.aqua, linewidth=1, style=plot.style_linebr)
plot(lt2, "LONG TARGET 2", color=color.blue, linewidth=1, style=plot.style_linebr)
plot(se, "SHORT BELOW", color=color.red, linewidth=2, style=plot.style_linebr)
plot(ss, "SHORT STOP", color=color.fuchsia, linewidth=1, style=plot.style_linebr)
plot(st1, "SHORT TARGET 1", color=color.purple, linewidth=1, style=plot.style_linebr)
plot(st2, "SHORT TARGET 2", color=color.maroon, linewidth=1, style=plot.style_linebr)

// Regular US equity session VWAP; extended hours excluded.
int nyDay = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
bool isIntraday = timeframe.isintraday
bool rth = isIntraday and not na(time(timeframe.period, "0930-1600:1234567", tz))
bool newRth = rth and (not rth[1] or nyDay != nyDay[1])
var float accumPV = 0.0
var float accumVol = 0.0
if newRth
    accumPV := 0.0
    accumVol := 0.0
if rth
    accumPV += hlc3 * nz(volume, 0)
    accumVol += nz(volume, 0)
float sessionVWAP = rth and accumVol > 0 ? accumPV / accumVol : na
plot(sessionVWAP, "RTH VWAP", color=color.yellow, linewidth=2, style=plot.style_linebr)

// PDH and PDL only visual reference. No lookahead in trade signals.
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
plot(showPD ? pdh : na, "PDH visual", color=color.new(color.gray, 55), linewidth=1, style=plot.style_linebr)
plot(showPD ? pdl : na, "PDL visual", color=color.new(color.gray, 55), linewidth=1, style=plot.style_linebr)

// Signals require confirmed bar, correct date, RTH and direction versus VWAP.
bool tradeDay = nyDay == 20261014
bool morning = isIntraday and not na(time(timeframe.period, "0940-1200:1234567", tz))
float avg20Volume = ta.sma(volume, 20)[1]
bool volumeOK = not requireVolume or (not na(avg20Volume) and volume >= 1.3 * avg20Volume)
bool signalTime = rth and tradeDay and (not morningOnly or morning)
bool longCross = ta.crossover(close, le)
bool shortCross = ta.crossunder(close, se)
bool longSignal = barstate.isconfirmed and signalTime and not na(le) and longCross and not na(sessionVWAP) and close > sessionVWAP and volumeOK
bool shortSignal = barstate.isconfirmed and signalTime and not na(se) and shortCross and not na(sessionVWAP) and close < sessionVWAP and volumeOK
plotshape(longSignal, title="LONG BREAKOUT", style=shape.labelup, location=location.belowbar, text="LONG", color=color.green, textcolor=color.white, size=size.tiny)
plotshape(shortSignal, title="SHORT BREAKDOWN", style=shape.labeldown, location=location.abovebar, text="SHORT", color=color.red, textcolor=color.white, size=size.tiny)
alertcondition(longSignal, title="LONG confirmed", message="{{ticker}} Oct 14 LONG breakout at {{close}}. Confirm options spread, risk and catalyst.")
alertcondition(shortSignal, title="SHORT confirmed", message="{{ticker}} Oct 14 SHORT breakdown at {{close}}. Confirm options spread, risk and catalyst.")

// Small labels replaced only on final chart bar.
f_price(float p) => na(p) ? "n/a" : str.tostring(p, format.mintick)
var array<label> priceLabels = array.new<label>()
if barstate.islast
    if array.size(priceLabels) > 0
        for i = 0 to array.size(priceLabels) - 1
            label.delete(array.get(priceLabels, i))
        array.clear(priceLabels)
    if showLabels and not na(le)
        array.push(priceLabels, label.new(bar_index + 3, le, "LONG > " + f_price(le), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny))
        array.push(priceLabels, label.new(bar_index + 3, ls, "L STOP " + f_price(ls), style=label.style_label_left, color=color.orange, textcolor=color.white, size=size.tiny))
        array.push(priceLabels, label.new(bar_index + 3, lt1, "L T1 " + f_price(lt1), style=label.style_label_left, color=color.teal, textcolor=color.white, size=size.tiny))
        array.push(priceLabels, label.new(bar_index + 3, lt2, "L T2 " + f_price(lt2), style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.tiny))
        array.push(priceLabels, label.new(bar_index + 3, se, "SHORT < " + f_price(se), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny))
        array.push(priceLabels, label.new(bar_index + 3, ss, "S STOP " + f_price(ss), style=label.style_label_left, color=color.fuchsia, textcolor=color.white, size=size.tiny))
        array.push(priceLabels, label.new(bar_index + 3, st1, "S T1 " + f_price(st1), style=label.style_label_left, color=color.purple, textcolor=color.white, size=size.tiny))
        array.push(priceLabels, label.new(bar_index + 3, st2, "S T2 " + f_price(st2), style=label.style_label_left, color=color.maroon, textcolor=color.white, size=size.tiny))

// High contrast white-text dashboard.
color dark = color.rgb(18, 24, 33)
color greenPanel = color.rgb(7, 101, 47)
color redPanel = color.rgb(154, 28, 42)
var table dash = table.new(position.top_right, 2, 12, border_width=1, frame_color=color.gray)
if barstate.islast
    table.cell(dash, 0, 0, "OCT 14 WATCH", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 0, symbol, text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 1, "LONG ABOVE", text_color=color.white, bgcolor=greenPanel, text_size=size.tiny)
    table.cell(dash, 1, 1, f_price(le), text_color=color.white, bgcolor=greenPanel, text_size=size.tiny)
    table.cell(dash, 0, 2, "LONG STOP", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 2, f_price(ls), text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 3, "LONG T1", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 3, f_price(lt1), text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 4, "LONG T2", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 4, f_price(lt2), text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 5, "SHORT BELOW", text_color=color.white, bgcolor=redPanel, text_size=size.tiny)
    table.cell(dash, 1, 5, f_price(se), text_color=color.white, bgcolor=redPanel, text_size=size.tiny)
    table.cell(dash, 0, 6, "SHORT STOP", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 6, f_price(ss), text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 7, "SHORT T1", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 7, f_price(st1), text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 8, "SHORT T2", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 8, f_price(st2), text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 9, "VWAP", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 9, f_price(sessionVWAP), text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 10, "PDH / PDL", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 10, f_price(pdh) + " / " + f_price(pdl), text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 0, 11, "DATE", text_color=color.white, bgcolor=dark, text_size=size.tiny)
    table.cell(dash, 1, 11, tradeDay ? "ACTIVE" : "HISTORICAL / PREVIEW", text_color=color.white, bgcolor=dark, text_size=size.tiny)
