    le := 37.2
    ls := 35.95
    lt1 := 38.65
    lt2 := 40.2
    se := 35.45
    ss := 36.75
    st1 := 34
    st2 := 32.4
    symbolName := "IREN"

if syminfo.ticker == "MU"
    le := 1021
    ls := 1007
    lt1 := 1039
    lt2 := 1057
