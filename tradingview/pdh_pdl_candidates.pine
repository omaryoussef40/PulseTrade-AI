//@version=6
indicator("PDH PDL Candidates — Approach / Break / Retest", overlay = false, max_bars_back = 100)

// Use 1D in Pine Screener. The setup engine processes completed regular-session
// 15-minute candles inside each daily bar, not the unfinished daily candle.
float minOpeningRV = input.float(1.5, "Minimum first-15m volume ratio", minval = 0.1, step = 0.1)
int volumeDays = input.int(20, "Opening volume lookback sessions", minval = 5, maxval = 60)
float minDailyVolume = input.float(1000000, "Minimum average daily shares (20 sessions)", minval = 0)
float minATRPercent = input.float(1.0, "Minimum daily ATR percent", minval = 0, step = 0.1)
float maxDistanceATR = input.float(0.25, "Maximum distance from level (daily ATR)", minval = 0.01, step = 0.05)
float retestToleranceATR = input.float(0.05, "Retest tolerance (daily ATR)", minval = 0, step = 0.01)
int freshBars = input.int(4, "Break/retest validity (15m bars after break)", minval = 1, maxval = 20)
bool requireVWAP = input.bool(true, "Require bullish above / bearish below VWAP")
bool todayOnly = input.bool(true, "Only today's candidates (New York date)")
bool limitWindow = input.bool(true, "Only scan from 09:45 through 11:30 New York")

if timeframe.period != "1D"
    runtime.error("Use the 1D timeframe. The script processes completed 15-minute candles internally.")

string regularTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[os, hs, ls, cs, vs, ts, tes] = request.security_lower_tf(regularTicker, "15", [open, high, low, close, volume, time, time_close])
[pdh, pdl, dailyATR, averageDailyVolume, previousClose] = request.security(regularTicker, "1D", [high[1], low[1], ta.atr(14)[1], ta.sma(volume, 20)[1], close[1]], lookahead = barmerge.lookahead_on)
[spyOpens, spyCloses, spyEnds] = request.security_lower_tf(ticker.new("AMEX", "SPY", session.regular), "15", [open, close, time_close], ignore_invalid_symbol = true)

bool isToday = year(time, "America/New_York") == year(timenow, "America/New_York") and month(time, "America/New_York") == month(timenow, "America/New_York") and dayofmonth(time, "America/New_York") == dayofmonth(timenow, "America/New_York")
int nowMinute = hour(timenow, "America/New_York") * 60 + minute(timenow, "America/New_York")

float openingVolume = na
float sessionOpen = na
float lastClose = na
float sessionVWAP = na
float cumulativeVolume = 0.0
float cumulativePV = 0.0
int lastEnd = na
int lastIndex = na
int bullBreakIndex = na
int bearBreakIndex = na
bool bullRetestHeld = false
bool bearRetestHeld = false
bool hasOpeningBar = false
float priorIntradayClose = na

// Rebuild state independently for every daily bar. Only completed intrabars
// contribute. No partially formed candle can confirm a break or retest.
if array.size(ts) > 0
    int firstTime = array.get(ts, 0)
    hasOpeningBar := hour(firstTime, "America/New_York") == 9 and minute(firstTime, "America/New_York") == 30
    if hasOpeningBar
        sessionOpen := array.get(os, 0)
        for i = 0 to array.size(ts) - 1
            int startTime = array.get(ts, i)
            int endTime = array.get(tes, i)
            if endTime <= timenow and endTime - startTime == 15 * 60 * 1000
                float h = array.get(hs, i)
                float l = array.get(ls, i)
                float c = array.get(cs, i)
                float v = array.get(vs, i)
                if i == 0
                    openingVolume := v
                cumulativeVolume += nz(v)
                cumulativePV += ((h + l + c) / 3.0) * nz(v)
                lastClose := c
                lastEnd := endTime
                lastIndex := i
                float tolerance = dailyATR * retestToleranceATR
                // A close back through the level invalidates that direction.
                // A later fresh crossing can begin a new setup.
                if c <= pdh
                    bullBreakIndex := na
                    bullRetestHeld := false
                else
                    if na(bullBreakIndex) and (i == 0 or priorIntradayClose <= pdh)
                        bullBreakIndex := i
                        bullRetestHeld := false
                    else if not na(bullBreakIndex) and i > bullBreakIndex and i - bullBreakIndex <= freshBars
                        if l <= pdh + tolerance and l >= pdh - tolerance and c > pdh
                            bullRetestHeld := true
                if c >= pdl
                    bearBreakIndex := na
                    bearRetestHeld := false
                else
                    if na(bearBreakIndex) and (i == 0 or priorIntradayClose >= pdl)
                        bearBreakIndex := i
                        bearRetestHeld := false
                    else if not na(bearBreakIndex) and i > bearBreakIndex and i - bearBreakIndex <= freshBars
                        if h >= pdl - tolerance and h <= pdl + tolerance and c < pdl
                            bearRetestHeld := true
                priorIntradayClose := c

sessionVWAP := cumulativeVolume > 0 ? cumulativePV / cumulativeVolume : na
float openingAverage = ta.sma(openingVolume[1], volumeDays)
float validOpeningDays = math.sum(not na(openingVolume[1]) ? 1.0 : 0.0, volumeDays)
bool historyReady = validOpeningDays == volumeDays and openingAverage > 0
float openingRV = historyReady and not na(openingVolume) ? openingVolume / openingAverage : na
float atrPercent = previousClose > 0 ? dailyATR / previousClose * 100.0 : na
float distancePDH = dailyATR > 0 ? (lastClose - pdh) / dailyATR : na
float distancePDL = dailyATR > 0 ? (lastClose - pdl) / dailyATR : na
int lastMinute = not na(lastEnd) ? hour(lastEnd, "America/New_York") * 60 + minute(lastEnd, "America/New_York") : 0
bool windowOK = not limitWindow or (lastMinute >= 585 and lastMinute <= 690 and (not isToday or (nowMinute >= 585 and nowMinute <= 690)))
// Reject halted/stale symbols during today's scan rather than presenting an
// old bar as a new candidate. Allow one 15m interval of feed latency.
bool recentData = not isToday or (not na(lastEnd) and timenow - lastEnd < 30 * 60 * 1000)
bool dataReady = hasOpeningBar and historyReady and not na(lastClose) and not na(pdh) and not na(pdl) and dailyATR > 0 and not na(averageDailyVolume) and cumulativeVolume > 0 and recentData
bool basePass = dataReady and (not todayOnly or isToday) and windowOK and openingRV >= minOpeningRV and averageDailyVolume >= minDailyVolume and atrPercent >= minATRPercent
bool bullVWAP = not requireVWAP or lastClose > sessionVWAP
bool bearVWAP = not requireVWAP or lastClose < sessionVWAP

// 0 = no qualifying setup, 1 = approaching, 2 = break confirmed, 3 = retest held.
// Distance is capped on either side to avoid listing already extended moves.
int bullStatus = 0
int bearStatus = 0
if basePass
    if bullVWAP and math.abs(distancePDH) <= maxDistanceATR
        if lastClose <= pdh
            bullStatus := 1
        else if not na(bullBreakIndex) and lastIndex - bullBreakIndex <= freshBars
            bullStatus := bullRetestHeld ? 3 : 2
    if bearVWAP and math.abs(distancePDL) <= maxDistanceATR
        if lastClose >= pdl
            bearStatus := 1
        else if not na(bearBreakIndex) and lastIndex - bearBreakIndex <= freshBars
            bearStatus := bearRetestHeld ? 3 : 2

// Compare open-to-last-completed-bar returns against SPY at the same close
// timestamp. Missing benchmark data leaves the ranking column blank only.
float spyReturn = na
if array.size(spyEnds) > 0 and not na(lastEnd)
    float spyOpen = array.get(spyOpens, 0)
    for i = 0 to array.size(spyEnds) - 1
        if array.get(spyEnds, i) == lastEnd and spyOpen > 0
            spyReturn := (array.get(spyCloses, i) / spyOpen - 1.0) * 100.0
float relativeStrength = sessionOpen > 0 and not na(spyReturn) ? (lastClose / sessionOpen - 1.0) * 100.0 - spyReturn : na

// First ten plots become Pine Screener columns.
plot(bullStatus, "Bull status", color = color.lime)
plot(bearStatus, "Bear status", color = color.red)
plot(openingRV, "Opening RVOL", color = color.blue)
plot(distancePDH, "Distance to PDH (ATR signed)", color = color.green)
plot(distancePDL, "Distance to PDL (ATR signed)", color = color.maroon)
plot(relativeStrength, "Strength vs SPY (percentage points)", color = color.purple)
plot(atrPercent, "Daily ATR percent", color = color.orange)
plot(lastClose, "Last completed 15m close", color = color.gray)
plot(dataReady ? 1 : 0, "Data ready", color = color.gray)
plot(averageDailyVolume, "Average daily shares", color = color.gray)
alertcondition(bullStatus > 0, "Bullish PDH candidate", "A bullish PDH candidate meets the configured scanner rules.")
alertcondition(bearStatus > 0, "Bearish PDL candidate", "A bearish PDL candidate meets the configured scanner rules.")
